# Copy to .env.local and fill in.

# Password for /admin. Required to add listings and manage orders.
ADMIN_PASSWORD=change-me

# Paystack secret key (sk_test_... while testing). Leave empty for demo payments.
PAYSTACK_SECRET_KEY=

# Public URL of the shop, used for Paystack's return link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number for the chat link, in 2547XXXXXXXX format. Defaults to the logo's number, 254741962189.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase database and photo storage. Leave empty to keep data in data/store.json and photos in data/uploads/.
# On Vercel these are added for you when you connect Supabase from the project's Storage tab.
POSTGRES_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
