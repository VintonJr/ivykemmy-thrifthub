# Copy to .env.local and fill in.

# Password for /admin. Required to add listings and manage orders.
ADMIN_PASSWORD=change-me

# Paystack secret key (sk_test_... while testing). Leave empty for demo payments.
PAYSTACK_SECRET_KEY=

# Public URL of the shop, used for Paystack's return link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number for the chat link, in 2547XXXXXXXX format.
NEXT_PUBLIC_WHATSAPP_NUMBER=
